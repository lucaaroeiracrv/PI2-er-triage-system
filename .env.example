# Copie para .env ou execute npm run configurar. Depois preencha a senha do SEU MySQL.
# Endereço em que o backend escuta; o padrão fica restrito ao computador local.
HOST=127.0.0.1
# Porta HTTP usada para abrir o sistema no navegador.
PORT=3000
# Endereço do servidor MySQL, que pode estar em outro computador.
DB_HOST=127.0.0.1
# Porta da conexão MySQL; é independente da porta HTTP do sistema.
DB_PORT=3306
# Conta do banco com permissão para criar o banco de exemplo e consultar suas tabelas.
DB_USER=root
# Preencha somente no .env local; a senha real não deve entrar no Git.
DB_PASSWORD=
# Use um banco separado para experimentar esta proposta de estrutura.
# Banco separado para testar a proposta sem substituir a estrutura existente do grupo.
DB_NAME=pi2_academico
# Deixe false para o teste local em HTTP. HTTPS permite ativar este atributo.
# No teste em HTTP fica false; em HTTPS pode exigir o envio do cookie somente por conexão segura.
COOKIE_SECURE=false
