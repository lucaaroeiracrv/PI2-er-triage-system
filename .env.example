# Configuração local do backend.
HOST=127.0.0.1
PORT=3000
COOKIE_SECURE=false

# Banco ativo da aplicação: oracle ou mysql.
DB_ENGINE=oracle

# Oracle Free local. Ajuste o serviço para a instalação Oracle usada.
DB_HOST=127.0.0.1
DB_PORT=1521
DB_SERVICE_NAME=FREEPDB1
DB_CONNECT_STRING=

# MySQL local. DB_MYSQL_PORT usa 3306 por padrão e DB_NAME define o schema.
DB_NAME=PI2_APP
DB_DATABASE=
DB_MYSQL_HOST=127.0.0.1
DB_MYSQL_PORT=3306
DB_MYSQL_USER=PI2_APP
DB_MYSQL_PASSWORD=
DB_MYSQL_ADMIN_USER=root
DB_MYSQL_ADMIN_PASSWORD=
DB_MYSQL_ACCOUNT_HOST=%

# A configuração local gera DB_PASSWORD aleatoriamente; não versione o valor.
DB_USER=PI2_APP
DB_PASSWORD=

# Usadas somente por "npm run criar:usuario"; informe a senha administrativa localmente.
DB_ADMIN_USER=SYSTEM
DB_ADMIN_PASSWORD=
