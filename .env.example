# Configuração local do backend.
HOST=127.0.0.1
PORT=3000
COOKIE_SECURE=false

# Oracle Free local. Ajuste o serviço para a instalação Oracle usada.
DB_HOST=127.0.0.1
DB_PORT=1521
DB_SERVICE_NAME=FREEPDB1
DB_CONNECT_STRING=

# A configuração local gera DB_PASSWORD aleatoriamente; não versione o valor.
DB_USER=PI2_APP
DB_PASSWORD=

# Usadas somente por "npm run criar:usuario"; informe a senha administrativa localmente.
DB_ADMIN_USER=SYSTEM
DB_ADMIN_PASSWORD=
