{
  "name": "pi2-atendimento",
  "version": "1.0.0",
  "private": true,
  "description": "Projeto integrador com interface compartilhada e backend Node.js/Oracle.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "formatar": "prettier --write .",
    "verificar:formatacao": "prettier --check .",
    "configurar": "node scripts/configurar-env.js",
    "criar:usuario": "node --env-file=.env scripts/criar-usuario-oracle.js",
    "criar:usuario:oracle": "node --env-file=.env scripts/criar-usuario-oracle.js",
    "criar:usuario:mysql": "DB_ENGINE=mysql node --env-file=.env scripts/criar-usuario-mysql.js",
    "preparar": "node --env-file=.env scripts/preparar-banco.js",
    "preparar:oracle": "node --env-file=.env scripts/preparar-banco.js",
    "preparar:mysql": "DB_ENGINE=mysql node --env-file=.env scripts/preparar-banco.js",
    "testar:conexao": "node --env-file=.env scripts/testar-conexao.js",
    "testar:oracle": "node --env-file=.env scripts/testar-conexao.js",
    "testar:mysql": "DB_ENGINE=mysql node --env-file=.env scripts/testar-conexao.js",
    "start": "node --env-file=.env src/servidor.js",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  },
  "dependencies": {
    "mysql2": "^3.12.0",
    "oracledb": "^26.0.0"
  }
}
